      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "\n",
        "veri = pd.read_excel('/antalya_ev_verisi.xlsx')\n",
        "veri = veri[veri['Büyüklük'].astype(str).str.contains('m²')]\n",
        "\n",
        "\n",
        "veri['Fiyat'] = veri['Fiyat'].astype(str).str.replace(' TL', '').str.replace('.', '', regex=False).astype(float)\n",
        "\n",
        "\n",
        "veri['Büyüklük'] = veri['Büyüklük'].astype(str).str.replace(' m²', '').astype(float)\n",
        "veri = veri.rename(columns={'Büyüklük': 'Metrekare'})\n",
        "\n",
        "\n",
        "veri['Kat'] = veri['Kat'].astype(str).str.lower()\n",
        "\n",
        "veri['Kat'] = veri['Kat'].replace(['yüksek giriş', 'düz giriş (zemin)', 'giriş katı', 'bahçe katı', 'bahçe dublex', 'villa tipi'], '0')\n",
        "\n",
        "veri['Kat'] = veri['Kat'].str.extract(r'(\\d+)').astype(float)\n",
        "\n",
        "\n",
        "veri = veri.drop(columns=['Konum', 'İlan Tarihi', 'Emlak Tipi'])\n",
        "\n",
        "\n",
        "veri_temiz = veri.dropna()\n",
        "\n",
        "print(\"--- Temizlenmiş Veri Seti (İlk 5 Satır) ---\")\n",
        "print(veri_temiz.head())\n",
        "print(\"\\nVeri Boyutu:\", veri_temiz.shape)"
